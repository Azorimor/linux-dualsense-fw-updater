#!/bin/sh
set -eu

msg_file="${1:?commit message file path required}"

subject=""
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    "# ------------------------ >8 ------------------------"*)
      break
      ;;
    \#*|"")
      continue
      ;;
    *)
      subject="$line"
      break
      ;;
  esac
done < "$msg_file"

if [ -z "$subject" ]; then
  echo "ERROR: Empty commit message." >&2
  exit 1
fi

# Allow standard git merge commits.
if printf '%s\n' "$subject" | grep -Eq '^Merge '; then
  exit 0
fi

pattern='^(feat|fix|refactor|perf|style|test|docs|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?(!)?: [^[:space:]].*$'
if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<EOF
ERROR: Commit message does not follow Conventional Commits.
Received:
  $subject

Expected format:
  <type>[optional scope]: <description>

Allowed types:
  feat, fix, refactor, perf, style, test, docs, build, ci, chore, revert

Examples:
  feat(protocol): add firmware image header parser
  refactor(hid): extract transport trait for testing
  test(cli): cover hex VID/PID parsing
  docs(agents): document module boundaries
EOF
  exit 1
fi

subject_len=$(printf '%s' "$subject" | wc -c | tr -d ' ')
if [ "$subject_len" -gt 72 ]; then
  echo "WARNING: Commit subject is $subject_len characters (recommended <= 72)." >&2
fi
